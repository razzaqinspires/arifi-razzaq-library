# PostgreSQL connection string. For Neon/Vercel Node.js deployments, use the pooled URI from Neon Console/CLI.
# Keep the real URI in .env or .env.local only; never commit it.
DATABASE_URL=postgresql://postgres:password@localhost:5432/arifi_library

# Use a long random password. Never commit the real value.
ADMIN_PASSWORD=change-this-to-a-long-unique-password

# At least 32 random bytes. Example generator: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Optional site settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set false only for a local PostgreSQL instance without SSL.
# DATABASE_SSL=false

# Vercel build migration switch. Defaults to enabled on Vercel; set false only for an external migration pipeline.
ARIFI_DB_AUTO_MIGRATE=true
# Set true to force a fresh Next.js production build on every local npm start.
ARIFI_REBUILD_ON_START=false
