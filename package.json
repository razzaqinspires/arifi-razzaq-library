{
  "name": "arifi-razzaq-creator-library",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/launch.mjs dev",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/launch.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-db.mjs",
    "neon:setup": "bash scripts/setup-neon.sh",
    "neon:status": "neon status"
  },
  "dependencies": {
    "next": "16.4.5",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "typescript": "^5.9.0"
  }
}
